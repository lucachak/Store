# Copy to .env and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=True
SITE_NAME=Tally
BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://app.example.com
TIME_ZONE=UTC

# --- Database (PostgreSQL) --------------------------------------------------
# Leave empty to use a local SQLite file.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas

# --- Production (DEBUG=False) -----------------------------------------------
# BEHIND_PROXY=True            # trust X-Forwarded-Proto from your proxy
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000 # enable once HTTPS works for every subdomain
# SESSION_IDLE_TIMEOUT=7200    # seconds, 0 disables it

# --- Email ------------------------------------------------------------------
# With DEBUG=True emails are printed to the console.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Tally <noreply@example.com>
# ADMINS=Your Name:you@example.com

# --- Stripe -----------------------------------------------------------------
# Use sk_test_... locally and sk_live_... in production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8000/checkout/webhook/`
# or the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=usd

# --- Social login (optional) ------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
